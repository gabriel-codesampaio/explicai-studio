{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run check)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npx vitest run:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "enabledPlugins": {
    "explicai-workflow@explicai-workflow": true
  },
  "extraKnownMarketplaces": {
    "explicai-workflow": {
      "source": {
        "source": "github",
        "repo": "gabriel-codesampaio/explicai-workflow"
      }
    }
  }
}
