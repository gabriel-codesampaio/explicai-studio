{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!!**/dist", "!**/web/src/components/ui", "!**/.impeccable", "!**/package-lock.json", "!**/*.md"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 130 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": { "enabled": true },
  "overrides": [
    {
      "includes": ["web/src/styles/base.css"],
      "linter": { "rules": { "complexity": { "noImportantStyles": "off" } } }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
