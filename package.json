{
  "name": "explicai",
  "version": "0.0.0",
  "description": "Construtor de manuais open source e gratuito. Do print ao manual pronto em PDF, HTML e Markdown.",
  "license": "MIT",
  "author": "Gabriel Sampaio",
  "homepage": "https://github.com/gabriel-codesampaio/explicai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabriel-codesampaio/explicai.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
